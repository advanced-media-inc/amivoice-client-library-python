{
  "filters": {
    "allowlist": {
      "allow": [
        "/:::.*/",
        "/例:/"
      ]
    }
  },
  "rules": {
    "preset-ja-spacing": {
      "ja-space-between-half-and-full-width": {
        "space": "always"
      }
    },
    "preset-ja-technical-writing": {
      "sentence-length": {
        "max": 150
      }
    },
    "@textlint-ja/preset-ai-writing": true
  }
}
